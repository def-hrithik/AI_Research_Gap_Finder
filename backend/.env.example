# ============================================================
# AI Research Gap Finder — Backend Environment Variables
# Copy to .env and fill values. NEVER commit .env.
# ============================================================

# --- App ---
ENVIRONMENT=development              # development | test | production
LOG_LEVEL=INFO
LOG_FORMAT=console                   # console | json (use json in production)
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/rgf.db

# --- CORS ---
CORS_ORIGINS=http://localhost:5173   # comma-separated exact origins
CORS_ORIGIN_REGEX=                   # optional regex for Vercel previews
FRONTEND_URL=                        # appended to CORS_ORIGINS
BACKEND_URL=                         # for absolute links in logs/docs

# --- Auth (demo-grade) ---
API_KEY=                             # if set, every /api/* needs X-API-Key
ALLOW_DEBUG_RESPONSES=false

# --- Upload limits ---
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=80
MAX_PAPERS_PER_PROJECT=30
MIN_CHARS_PER_PAGE=200

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_SEARCH=20/minute
RATE_LIMIT_ANALYZE=5/minute

# --- Jobs ---
ANALYSIS_MAX_CONCURRENCY=2
AUTO_ANALYZE_ON_INGEST=true

# --- LLM ---
LLM_PROVIDER=openai_compatible       # openai_compatible | anthropic | fake
LLM_API_KEY=your-api-key-here
LLM_MODEL=your-model-name
LLM_BASE_URL=                        # e.g. https://api.openai.com/v1
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=4

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DEVICE=auto                # auto | cpu | cuda
EMBEDDING_LAZY_LOAD=false
EMBEDDING_MAX_TOKENS=1024
HF_HOME=./data/hf

# --- Reranker ---
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_ENABLED=true
RERANK_BATCH_SIZE=16
RERANK_MAX_LENGTH=512
RERANK_CANDIDATES=50
RERANK_TOP_K=10
RERANK_MIN_SCORE=0.20
RERANK_WEIGHT=0.85
PRIOR_WEIGHT=0.15

# --- Retrieval ---
RETRIEVAL_DENSE_TOP_K=40
RETRIEVAL_BM25_TOP_K=40
RRF_K=60
SECTION_BOOST_ENABLED=true
QUERY_REWRITE_MODE=rules             # off | rules | llm
BM25_CACHE_PROJECTS=8
MIN_EVIDENCE_CHUNKS=2
MAX_CHUNKS_PER_PAPER=3
CONTEXT_MAX_TOKENS=6000
PAPER_CONTEXT_MAX_TOKENS=8000

# --- Chunking ---
CHUNK_TARGET_TOKENS=350
CHUNK_MAX_TOKENS=600
CHUNK_MIN_TOKENS=60
CHUNK_OVERLAP_SENTENCES=2

# --- Qdrant (exactly one of URL or LOCAL_PATH must be set) ---
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_LOCAL_PATH=./data/qdrant
QDRANT_COLLECTION=rgf_chunks
QDRANT_UPSERT_BATCH=128

# --- Analysis ---
CONTRADICTION_MAX_PAIRS=8
FUTURE_CLUSTER_DISTANCE=0.25
GAP_MAX_PER_CATEGORY=3
GAP_MAX_TOTAL=15
GAP_W_PAPERS=0.35
GAP_W_ENTAIL=0.25
GAP_W_VERIFIED=0.10
GAP_W_RETRIEVAL=0.15
GAP_W_TYPE=0.15
GAP_CAP_EXPLICIT=0.90
GAP_CAP_EXPLICIT_SINGLE=0.60
GAP_CAP_SYNTH_PRESENCE=0.85
GAP_CAP_SYNTH_ABSENCE=0.65
GAP_TYPE_FACTOR_SYNTH_PRESENCE=0.6
GAP_TYPE_FACTOR_SYNTH_ABSENCE=0.4
ABSENCE_REFUTE_MIN_SCORE=0.5
